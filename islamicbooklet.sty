\newcommand{\ib@drawnframe}{%
  \setlength{\ib@bandwd}{\paperwidth}%
  \addtolength{\ib@bandwd}{-2\ib@frameinset}%
  \addtolength{\ib@bandwd}{-2\ib@framecorner}%
  \setlength{\ib@bandht}{\paperheight}%
  \addtolength{\ib@bandht}{-2\ib@frameinset}%
  \addtolength{\ib@bandht}{-2\ib@framecorner}%
\begin{tikzpicture}[remember picture,overlay,color=framegrey]
  \coordinate (ib@tl) at ($(current page.north west)+( \ib@frameinset,-\ib@frameinset)$);
  \coordinate (ib@tr) at ($(current page.north east)+(-\ib@frameinset,-\ib@frameinset)$);
  \coordinate (ib@bl) at ($(current page.south west)+( \ib@frameinset, \ib@frameinset)$);
  \coordinate (ib@br) at ($(current page.south east)+(-\ib@frameinset, \ib@frameinset)$);
  \draw[line width=0.5pt]
    ($(current page.north west)+( \ib@framerule,-\ib@framerule)$) rectangle
    ($(current page.south east)+(-\ib@framerule, \ib@framerule)$);
  \pgfmathtruncatemacro{\ib@nh}{max(1,round(\ib@bandwd/\ib@tiletarget))}%
  \pgfmathsetlength{\ib@tilewd}{\ib@bandwd/\ib@nh}%
  \pgfmathtruncatemacro{\ib@nv}{max(1,round(\ib@bandht/\ib@tiletarget))}%
  \pgfmathsetlength{\ib@tileht}{\ib@bandht/\ib@nv}%
  \foreach \k in {1,...,\ib@nh}{%
    \node[anchor=north] at
      ([xshift=\dimexpr\ib@frameinset+\ib@framecorner
               +\k\ib@tilewd-0.5\ib@tilewd\relax,
        yshift=-\ib@frameinset]current page.north west)
      {\pgfornament[width=\the\ib@tilewd]{\ib@sideorn}};
    \node[anchor=south] at
      ([xshift=\dimexpr\ib@frameinset+\ib@framecorner
               +\k\ib@tilewd-0.5\ib@tilewd\relax,
        yshift=\ib@frameinset]current page.south west)
      {\pgfornament[width=\the\ib@tilewd,symmetry=h]{\ib@sideorn}};}
  \foreach \k in {1,...,\ib@nv}{%
    \node[rotate=90,anchor=north] at
      ([xshift=\ib@frameinset,
        yshift=-\dimexpr\ib@frameinset+\ib@framecorner
               +\k\ib@tileht-0.5\ib@tileht\relax]current page.north west)
      {\pgfornament[width=\the\ib@tileht]{\ib@sideorn}};
    \node[rotate=-90,anchor=north] at
      ([xshift=-\ib@frameinset,
        yshift=-\dimexpr\ib@frameinset+\ib@framecorner
               +\k\ib@tileht-0.5\ib@tileht\relax]current page.north east)
      {\pgfornament[width=\the\ib@tileht]{\ib@sideorn}};}
  \node[anchor=north west] at (ib@tl)
    {\pgfornament[width=\ib@framecorner]{\ib@cornerorn}};
  \node[anchor=north east] at (ib@tr)
    {\pgfornament[width=\ib@framecorner,symmetry=v]{\ib@cornerorn}};
  \node[anchor=south west] at (ib@bl)
    {\pgfornament[width=\ib@framecorner,symmetry=h]{\ib@cornerorn}};
  \node[anchor=south east] at (ib@br)
    {\pgfornament[width=\ib@framecorner,symmetry=c]{\ib@cornerorn}};
\end{tikzpicture}}

