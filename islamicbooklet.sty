\newcommand{\ib@ordinal}[1]{%
  \number#1\begingroup
  \count0=#1\relax \count2=\count0 \divide\count2 by 100
  \multiply\count2 by 100 \advance\count0 by -\count2   %
  \ifnum\count0>10 \ifnum\count0<14 \textsuperscript{th}\else\ib@ord@ones{#1}\fi
  \else\ib@ord@ones{#1}\fi\endgroup}
\newcommand{\ib@ord@ones}[1]{%
  \count0=#1\relax \count2=\count0 \divide\count2 by 10
  \multiply\count2 by 10 \advance\count0 by -\count2    %
  \ifcase\count0 \textsuperscript{th}\or\textsuperscript{st}\or
    \textsuperscript{nd}\or\textsuperscript{rd}\else\textsuperscript{th}\fi}

\newcommand{\heading}[1]{%
  \needspace{6\baselineskip}%
  \refstepcounter{section}%
  \par\vspace{1.2\baselineskip}%
  {\headingfont\fontsize{20pt}{24pt}\selectfont
   \raggedright
   \noindent\hangindent=\ib@headindent\hangafter=1
   \ifx\ib@headlabel\@empty
     \thesection.\hspace{0.6em}%
   \else
     \ib@ordinal{\value{section}}\ \ib@headlabel:\hspace{0.4em}%
   \fi
   #1}%
  \addcontentsline{toc}{section}{\protect\numberline{\thesection}#1}%
  \par\vspace{0.3\baselineskip}}

