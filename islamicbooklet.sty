\newcommand{\ib@clearparts}{%
  \global\let\ib@p@framing\@empty
  \global\let\ib@p@ar\@empty
  \global\let\ib@p@tl\@empty
  \global\let\ib@p@en\@empty
  \global\let\ib@p@src\@empty
  \global\let\ib@p@surah\@empty}

\newcommand{\ib@set@framing}[1]{\gdef\ib@p@framing{#1}}
\newcommand{\ib@set@ar}[1]{\gdef\ib@p@ar{#1}}
\newcommand{\ib@set@tl}[1]{\gdef\ib@p@tl{#1}}
\newcommand{\ib@set@en}[1]{\gdef\ib@p@en{#1}}
\newcommand{\ib@set@src}[1]{\gdef\ib@p@src{#1}}
\newcommand{\ib@set@surah}[2]{\gdef\ib@p@surah{\iblabelsurah{} #1 (#2)}}

\newcommand{\ib@readparts}{%
  \ib@clearparts
  \begingroup
    \let\framing\ib@set@framing
    \let\ar\ib@set@ar
    \let\tl\ib@set@tl
    \let\en\ib@set@en
    \let\src\ib@set@src
    \let\surah\ib@set@surah
    \setbox\z@=\vbox{\BODY}%
  \endgroup}

\newcommand{\ib@ifpart}[3]{%
  \ifx#1\@empty #3\else #2\fi}

\newcommand{\ib@typeset@tl}{%
  \ib@ifpart{\ib@p@tl}{{\translitfont\itshape\ib@p@tl}\par}{}}

\newcommand{\ib@typeset@framing}{%
  \ib@ifpart{\ib@p@framing}%
    {\needspace{3\baselineskip}\ib@p@framing\par\nopagebreak[4]}{}}

\newcommand{\ib@srcsep}{\penalty200\ }
\newcommand{\ib@typeset@src}{%
  \ib@ifpart{\ib@p@surah}%
    {\ib@srcsep[\ib@p@surah]}%
    {\ib@ifpart{\ib@p@src}{\ib@srcsep[\ib@p@src]}{}}}

\newif\ifib@noquotes
\newcommand{\ib@noquotes@key}{noquotes}
\newcommand{\ib@setnoquotes}[1]{%
  \ib@noquotesfalse
  \def\ib@given{#1}%
  \ifx\ib@given\ib@noquotes@key\ib@noquotestrue\fi}

\newcommand{\ib@quoted}[3]{\ifib@noquotes #2\else #1#2#3\fi}

\newif\ifib@qpending
\newcommand{\ib@openmark}{}
\newcommand{\ib@flushopen}{%
  \ifib@qpending\ \ib@openmark\global\ib@qpendingfalse\fi
  \ignorespaces}
\newcommand{\isnad}[1]{{\color{black}#1}\ib@flushopen}

\newif\ifib@hasisnad
\newcommand{\ib@scanmark}{}
\long\def\ib@scan#1\isnad#2#3\ib@scanend{%
  \ifx\ib@scanmark#2\ib@hasisnadfalse\else\ib@hasisnadtrue\fi}
\long\def\ib@testisnad#1{\ib@scan#1\isnad\ib@scanmark\ib@scanend}

\newcommand{\ib@quotedpart}[3]{%
  \ifib@noquotes
    #2%
  \else
    \expandafter\ib@testisnad\expandafter{#2}%
    \ifib@hasisnad
      \def\ib@openmark{#1}\global\ib@qpendingtrue #2#3%
    \else
      #1#2#3%
    \fi
  \fi}

\NewEnviron{ayah}{%
  \begingroup\ib@blockopen
  \ib@readparts
  \ib@typeset@framing
  \ib@ifpart{\ib@p@ar}%
    {\ib@ar{\quranfont}{quranred}{%
       {\bracketfont\ib@arsize ﴿}\ib@p@ar{\bracketfont\ib@arsize ﴾}}}{}%
  \ib@typeset@tl
  \ib@ifpart{\ib@p@en}%
    {{\color{glossgrey}\iblabelmeaning}~%
     {\color{quranred}%
       {\bracketfont\ib@ensize ﴾}\ib@p@en{\bracketfont\ib@ensize ﴿}}}{}%
  \ib@typeset@src\ib@blockclose\endgroup}

\newcommand{\ib@enopen}{{\naskhfont\ib@ensize «}}
\newcommand{\ib@enclose}{{\naskhfont\ib@ensize »}}
\NewEnviron{hadith}[1][]{%
  \begingroup\ib@blockopen
  \ib@setnoquotes{#1}%
  \ib@readparts
  \ib@typeset@framing
  \ib@ifpart{\ib@p@ar}%
    {\ib@ar{\naskhfont}{hadithgreen}{\ib@quotedpart{«}{\ib@p@ar}{»}}}{}%
  \ib@typeset@tl
  \ib@ifpart{\ib@p@en}%
    {{\color{hadithgreen}%
      \ib@quotedpart{\ib@enopen}{\ib@p@en}{\ib@enclose}}}{}%
  \ib@typeset@src\ib@blockclose\endgroup}

\NewEnviron{athar}[1][]{%
  \begingroup\ib@blockopen
  \ib@setnoquotes{#1}%
  \ib@readparts
  \ib@typeset@framing
  \ib@ifpart{\ib@p@ar}%
    {\ib@ar{\naskhfont}{atharblue}{\ib@quotedpart{«}{\ib@p@ar}{»}}}{}%
  \ib@typeset@tl
  \ib@ifpart{\ib@p@en}%
    {{\color{atharblue}%
      \ib@quotedpart{\ib@enopen}{\ib@p@en}{\ib@enclose}}}{}%
  \ib@typeset@src\ib@blockclose\endgroup}

